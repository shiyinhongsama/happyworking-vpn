{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HappyWorking VPN",
  "version": "0.1.0",
  "identifier": "com.happyworking.vpn",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build:frontend"
  },
  "app": {
    "windows": [
      {
        "title": "HappyWorking VPN",
        "width": 920,
        "height": 640,
        "minWidth": 360,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:"
    }
  }
}
